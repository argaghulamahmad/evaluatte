# Copy to .env (gitignored) or export these in your shell. Values are never committed.

# Django
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=

# Database
DB_NAME=evaluatte
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Midtrans (sandbox key in dev, production key in prod)
MIDTRANS_SERVER_KEY=

# Direct-to-S3 uploads (presigned POST, credentials used server-side only)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_UPLOAD_BUCKET=
AWS_UPLOAD_REGION=ap-southeast-1
AWS_UPLOAD_PUBLIC_DOMAIN=

# Optional: log directory used by production settings (default /home/argaghulamahmad/logs).
# Leave unset in Docker: the image sets LOG_DIR=/var/log/evaluatte. An empty value here breaks startup.
# LOG_DIR=/var/log/evaluatte
